# ─── Vision Assistant — Environment Variables ───
# Copy to .env.local and fill in real values. Never commit .env.local.

# LLM provider: "gemini" or "anthropic"
LLM_PROVIDER=gemini

# Model name (default: gemini-3.8-flash / claude-3-5-sonnet-20241022)
LLM_MODEL=gemini-3.8-flash

# API keys — only set the one matching your provider
GEMINI_API_KEY=your_gemini_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Geocoding (Nominatim) and Routing (OSRM) are free public APIs — no keys needed.
